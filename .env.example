# =============================================================================
# ENVIRONMENT VARIABLES CHECKLIST
# =============================================================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/chant_esperance_db?schema=public"
#
# Production examples:
# Vercel Postgres: Automatically provided
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
# Railway: Automatically provided

# -----------------------------------------------------------------------------
# NEXTAUTH.JS CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# NextAuth URL - The canonical URL of your site
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret - Used to encrypt JWT tokens
# IMPORTANT: Generate with: openssl rand -base64 32
# NEVER use the same secret in development and production
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Public URL of the application (used for SEO, sitemap, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# OPTIONAL: EMAIL CONFIGURATION (Future feature)
# -----------------------------------------------------------------------------
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-email-password"
# SMTP_FROM="noreply@your-domain.com"

# -----------------------------------------------------------------------------
# SEARCH CONFIGURATION (Typesense)
# -----------------------------------------------------------------------------
# Typesense Cloud: Sign up at https://cloud.typesense.org
# Self-hosted: See https://typesense.org/docs/guide/install-typesense.html
#
# For Typesense Cloud:
# TYPESENSE_HOST="xxx.a1.typesense.net"
# TYPESENSE_PORT="443"
# TYPESENSE_PROTOCOL="https"
#
# For local development (Docker):
# TYPESENSE_HOST="localhost"
# TYPESENSE_PORT="8108"
# TYPESENSE_PROTOCOL="http"
#
# Admin API Key (for indexing/management - server-side only)
TYPESENSE_ADMIN_API_KEY="your-typesense-admin-api-key"
#
# Search-only API Key (can be exposed to client-side)
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY="your-typesense-search-only-api-key"
NEXT_PUBLIC_TYPESENSE_HOST="xxx.a1.typesense.net"
NEXT_PUBLIC_TYPESENSE_PORT="443"
NEXT_PUBLIC_TYPESENSE_PROTOCOL="https"

# -----------------------------------------------------------------------------
# OPTIONAL: FILE STORAGE (Future feature)
# -----------------------------------------------------------------------------
# AWS S3
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_S3_BUCKET="your-bucket-name"
#
# OR Cloudinary
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"

# -----------------------------------------------------------------------------
# OPTIONAL: ANALYTICS & MONITORING (Recommended for production)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# =============================================================================
# QUICK SETUP GUIDE
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate NEXTAUTH_SECRET: openssl rand -base64 32
# 3. Set DATABASE_URL to your PostgreSQL connection string
# 4. Set NEXTAUTH_URL and NEXT_PUBLIC_APP_URL
# 5. Create admin user: see README.md for instructions
# =============================================================================
